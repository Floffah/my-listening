        "@tanstack/react-query": "^5.90.20",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "convex": "^1.31.7",
        "convex-env": "^2.4.1",
        "fflate": "^0.8.2",
        "lucide-react": "^0.563.0",
        "motion": "^12.31.0",
        "next": "16.1.6",
        "radix-ui": "^1.4.3",
