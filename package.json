{
    "name": "my-listening",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "turbo dev:frontend dev:backend",
        "dev:frontend": "next dev --turbopack",
        "dev:backend": "convex dev",
        "build": "turbo :build",
        ":build": "next build --turbopack",
        "deploy": "convex deploy --cmd \"bun run build\"",
        "start": "next start",
        "lint": "next lint",
        "prepare": "bunx --bun @svgr/cli --out-dir src/components/icons --typescript --no-prettier --no-dimensions -- icons",
        "test": "bun test --watch",
        "test:once": "bun test",
        "test:debug": "bun test --inspect-brk",
        "test:coverage": "bun test --coverage"
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@clerk/nextjs": "^7.5.20",
        "@clerk/ui": "^1.25.5",
        "@convex-dev/react-query": "^0.1.0",
        "@convex-dev/sharded-counter": "^0.2.1",
        "@convex-dev/workflow": "^0.4.4",
        "@convex-dev/workpool": "^0.4.8",
        "@icons-pack/react-simple-icons": "^13.13.0",
        "@spotify/web-api-ts-sdk": "^1.2.0",
        "@tanstack/react-query": "^5.101.2",
        "@tanstack/react-virtual": "^3.14.6",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "convex": "^1.42.3",
        "convex-env": "^3.0.0",
        "date-fns": "^4.4.0",
        "fflate": "^0.8.3",
        "lucide-react": "^1.25.0",
        "motion": "^12.42.2",
        "next": "16.2.10",
        "radix-ui": "^1.6.2",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "react-intersection-observer": "^10.1.0",
        "shadcn": "^4.13.1",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "yauzl": "^3.4.0"
    },
    "devDependencies": {
        "@svgr/cli": "^8.1.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/bun": "^1.3.14",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@types/yauzl": "^3.4.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.39.2",
        "eslint-config-next": "16.2.10",
        "prettier": "^3.9.5",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "turbo": "^2.10.5",
        "typescript": "6.0.3"
    },
    "ignoreScripts": [
        "sharp",
        "unrs-resolver"
    ],
    "trustedDependencies": [
        "esbuild",
        "sharp",
        "unrs-resolver"
    ],
    "packageManager": "bun@1.3.14"
}
